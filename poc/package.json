{
  "name": "gemini-image-studio-poc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.22.2 || >=24.15.0" },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "tsx watch backend/src/server.ts",
    "dev:frontend": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "auth": "tsx backend/src/auth.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx backend/src/server.ts",
    "test": "vitest run",
    "test:e2e": "playwright test --project=fixture",
    "test:live": "playwright test --project=live",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.468.0",
    "playwright": "^1.58.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "jsdom": "^26.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.12"
  }
}
