# Postgres (required)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=akkio

# Auth (required in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=2880
GOOGLE_CLIENT_ID=

# Server
ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3002

# LLM provider keys (at least one required for AI features)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Usage defaults
DEFAULT_AI_CREDITS=100
DEFAULT_STORAGE_MB=50
TOKENS_PER_CREDIT=1000

# App Builder runtime
APP_BUILDER_RUNTIME_DIR=

# Optional: E2B cloud sandbox build
E2B_API_KEY=
APP_BUILDER_USE_E2B=false

# Optional: GitHub push + EC2 deployment
GITHUB_TOKEN=
DEPLOY_EC2_IP=
DEPLOY_SSH_KEY_PATH=
DEPLOY_SSH_USER=ubuntu

# Seed admin (scripts/seed_admin.py)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
