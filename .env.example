# Postgres (required)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=akkio

# Auth (required in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=2880
GOOGLE_CLIENT_ID=

# Server
ENV=development
HOST=0.0.0.0
PORT=8000
# Public base URL for preview/live links returned to the frontend (Hostinger: http://YOUR_IP:8000)
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated browser origins (where the React app is served from)
CORS_ORIGINS=http://localhost:3002,http://localhost:3000,http://127.0.0.1:3002
# In development, localhost + IP:port origins are also allowed via regex (see api/cors_config.py)
# CORS_ALLOW_ALL=true
# CORS_ORIGIN_REGEX=https?://(.*\.)?example\.com(:\d+)?

# LLM provider keys (at least one required for AI features)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Usage defaults
DEFAULT_AI_CREDITS=100
DEFAULT_STORAGE_MB=50
TOKENS_PER_CREDIT=1000

# App Builder runtime (persistent path on Hostinger, e.g. /var/akkio/runtime/projects)
APP_BUILDER_RUNTIME_DIR=

# npm build timeouts (seconds) — increase on slow VPS
NPM_INSTALL_TIMEOUT=300
NPM_BUILD_TIMEOUT=600

# Codegen: verify npm build during Generate Code; AI auto-fix on failure (default on)
CODEGEN_VERIFY_BUILD=true
CODEGEN_BUILD_FIX_ATTEMPTS=3

# Run App: auto-fix build failures with AI (default on)
RUN_BUILD_AUTO_FIX=true
RUN_BUILD_FIX_ATTEMPTS=3

# Optional: E2B cloud sandbox build
E2B_API_KEY=
APP_BUILDER_USE_E2B=false

# Optional: GitHub push (repo export only)
GITHUB_TOKEN=

# Optional: run pytest during deploy (default off)
DEPLOY_RUN_TESTS=false
DEPLOY_PYTEST_TIMEOUT=120

# Removed for POC — Hostinger uses local deploy on same VPS (see docs/HOSTINGER.md)
# DEPLOY_EC2_IP=
# DEPLOY_SSH_KEY_PATH=
# DEPLOY_SSH_USER=

# Seed admin (scripts/seed_admin.py)
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=Admin@123
