  "pages": [
    {
      "id": "dashboard",
      "title": "Dashboard",
      "subtitle": "Dashboard",
      "blocks": [
        {
          "type": "kpiRow",
          "dataKey": "kpis_dashboard",
          "items": [
            {
              "label": "Oee",
              "valueKey": "oee",
              "color": "primary"
            },
            {
              "label": "Throughput",
              "valueKey": "throughput",
              "color": "success"
            },
            {
              "label": "Downtime",
              "valueKey": "downtime",
              "color": "warning"
            },
            {
              "label": "Active Alerts",
              "valueKey": "active_alerts",
              "color": "info"
            },
            {
              "label": "Scrap Rate",
              "valueKey": "scrap_rate",
              "color": "error"
            },
            {
              "label": "Energy Per Unit",
              "valueKey": "energy_per_unit",
              "color": "primary"
            }
          ]
        },
        {
          "type": "lineChart",
          "title": "Dashboard \u2014 performance trend",
          "dataKey": "series_dashboard_performance",
          "xAxisKey": "period",
          "series": [
            {
              "dataKey": "oee",
              "name": "OEE %",
              "color": "#1976d2"
            },
            {
              "dataKey": "target",
              "name": "Target",
              "color": "#94a3b8"
            }
          ],
          "height": 320
        },
        {
          "type": "barChart",
          "title": "Dashboard \u2014 shift comparison",
          "dataKey": "series_dashboard_shift",
          "xAxisKey": "period",
          "series": [
            {
              "dataKey": "output",
              "name": "Actual output",
              "color": "#1976d2"
            },
            {
              "dataKey": "planned",
              "name": "Planned",
              "color": "#9c27b0"
            }
          ],
          "height": 300
        },
        {
          "type": "pieChart",
          "title": "Dashboard \u2014 alert distribution",
          "dataKey": "pie_dashboard_alerts",
          "height": 280
        },
        {
          "type": "dataTable",
          "title": "Plant floor alerts",
          "dataKey": "table_dashboard_alerts",
