{
  "version": 1,
  "meta": {
    "appName": "PulsePlant",
    "description": "Default template \u2014 all UI is driven from mock/data.json",
    "domain": "manufacturing"
  },
  "theme": {
    "primary": "#1976d2",
    "primaryDark": "#1565c0",
    "primaryLight": "#42a5f5",
    "secondary": "#9c27b0",
    "background": "#f5f7fb",
    "surface": "#ffffff",
    "text": "#0f172a",
    "muted": "#64748b",
    "danger": "#d32f2f",
    "success": "#2e7d32",
    "warning": "#ed6c02",
    "info": "#0288d1",
    "fontFamily": "Inter",
    "chartPalette": [
      "#1976d2",
      "#2e7d32",
      "#ed6c02",
      "#9c27b0",
      "#0288d1",
      "#d32f2f"
    ]
  },
  "navigation": [
    {
      "label": "Dashboard",
      "path": "/",
      "icon": "Dashboard",
      "pageId": "dashboard"
    },
    {
      "label": "Analytics",
      "path": "/analytics",
      "icon": "ShowChart",
      "pageId": "analytics"
    },
    {
      "label": "Reports",
      "path": "/reports",
      "icon": "Assessment",
      "pageId": "reports"
    }
  ],
  "pages": [
    {
      "id": "dashboard",
      "title": "Dashboard",
      "subtitle": "Dashboard",
      "blocks": [
        {
          "type": "kpiRow",
          "items": [
            {
              "label": "OEE",
              "valueKey": "oee",
              "color": "primary"
            },
            {
              "label": "Throughput",
              "valueKey": "throughput",
              "color": "success"
            },
            {
              "label": "Downtime (today)",
              "valueKey": "downtime",
              "color": "warning"
            },
            {
              "label": "Active alerts",
              "valueKey": "active_alerts",
              "color": "error"
            }
          ]
        },
        {
          "type": "lineChart",
          "title": "Dashboard \u2014 OEE trend",
          "dataKey": "series_dashboard_trend",
          "xAxisKey": "label",
          "series": [
            {
              "dataKey": "oee",
              "name": "OEE %",
              "color": "#1976d2"
            },
            {
              "dataKey": "target",
              "name": "Target",
              "color": "#94a3b8"
            }
          ],
          "height": 300
        }
      ]
    },
    {
      "id": "analytics",
      "title": "Analytics",
      "subtitle": "Analytics",
      "blocks": [
        {
          "type": "kpiRow",
          "items": [
            {
              "label": "MTBF",
              "valueKey": "mtbf",
              "color": "primary"
            },
            {
              "label": "First-pass yield",
              "valueKey": "first_pass_yield",
              "color": "success"
            },
            {
              "label": "Scrap rate",
              "valueKey": "scrap_rate",
              "color": "warning"
            }
          ]
        },
        {
          "type": "barChart",
          "title": "Analytics comparison",
          "dataKey": "series_analytics_bars",
          "xAxisKey": "label",
          "series": [
            {
              "dataKey": "output",
              "name": "Output (units)",
              "color": "#1976d2"
            },
            {
              "dataKey": "defects",
              "name": "Defects",
              "color": "#d32f2f"
            }
          ],
          "height": 300
        },
        {
          "type": "dataTable",
          "title": "Machine performance",
          "dataKey": "table_analytics",
          "columns": [
            {
              "field": "id",
              "header": "ID"
            },
            {
              "field": "name",
              "header": "Machine"
            },
            {
              "field": "value",
              "header": "OEE %",
              "align": "right"
            },
            {
              "field": "status",
              "header": "Status"
            }
          ],
          "searchable": true
        }
      ]
    },
    {
      "id": "reports",
      "title": "Reports",
      "subtitle": "Reports",
      "blocks": [
        {
          "type": "kpiRow",
          "items": [
            {
              "label": "Reports (30d)",
              "valueKey": "reports_count",
              "color": "primary"
            },
            {
              "label": "On-time delivery",
              "valueKey": "on_time_delivery",
              "color": "success"
            }
          ]
        },
        {
          "type": "dataTable",
          "title": "Report library",
          "dataKey": "table_reports",
          "columns": [
            {
              "field": "name",
              "header": "Report"
            },
            {
              "field": "period",
              "header": "Period"
            },
            {
              "field": "owner",
              "header": "Owner"
            },
            {
              "field": "status",
              "header": "Status"
            }
          ],
          "searchable": true
        }
      ]
    }
  ],
