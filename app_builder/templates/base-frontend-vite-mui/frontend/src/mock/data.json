            {
              "field": "id",
              "header": "ID"
            },
            {
              "field": "unit",
              "header": "Unit / line"
            },
            {
              "field": "severity",
              "header": "Severity"
            },
            {
              "field": "type",
              "header": "Type"
            },
            {
              "field": "message",
              "header": "Message"
            },
            {
